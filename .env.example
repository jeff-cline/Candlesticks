# ─── Candlesticks.ai configuration ──────────────────────────────────────────
# Copy to .env and fill in.  .env is gitignored — never commit real secrets.

NODE_ENV=development
PORT=3000
SITE_URL=https://candlesticks.ai

# Session signing secret. Generate with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-64-char-random-hex-string

# ─── God account ────────────────────────────────────────────────────────────
# Seeded on first run by `npm run seed`. The temp password is force-changed at
# first login; it is stored only as a bcrypt hash.
GOD_EMAIL=jeff.cline@me.com
GOD_TEMP_PASSWORD=TEMP!234

# ─── Email (lead notifications: Join + footer forms) ────────────────────────
# Any SMTP provider. If unset, mail is written to the console and the DB
# instead of being sent, so the forms still work in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Candlesticks.ai <noreply@candlesticks.ai>"
LEAD_NOTIFY_TO=jeff.cline@me.com

# ─── Tradovate ──────────────────────────────────────────────────────────────
# Live trading stays OFF until these are set AND TRADING_ENABLED=true.
# Demo endpoint: https://demo.tradovateapi.com/v1
# Live endpoint: https://live.tradovateapi.com/v1
TRADOVATE_ENV=demo
TRADOVATE_API_URL=https://demo.tradovateapi.com/v1
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=Candlesticks
TRADOVATE_APP_VERSION=0.1.0
TRADOVATE_CID=
TRADOVATE_SEC=

# Master kill switch. Nothing is ever staged against a live account unless
# this is explicitly true. Default false.
TRADING_ENABLED=false

# ─── Market data / news feeds (see Integrations tab) ────────────────────────
DATABENTO_API_KEY=
POLYGON_API_KEY=
BENZINGA_API_KEY=
FINNHUB_API_KEY=
TRADINGECONOMICS_API_KEY=

# ─── Risk defaults (overridable per-account in the UI) ──────────────────────
DEFAULT_MAX_DAILY_LOSS_PCT=40
DEFAULT_DRAWDOWN_FLOOR_PCT=20
FLATTEN_MINUTES_BEFORE_CLOSE=5
SESSION_OPEN_DELAY_MINUTES=5
